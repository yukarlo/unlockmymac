<!--
  Quick Settings tile icon: an open padlock with a broadcast arc.

  Single flat path, tinted by the system. Quick Settings applies its own colour to indicate
  on/off, so this must carry no colour of its own and no filled background — an icon that
  paints its own state ends up contradicting the tile it sits in.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="24dp"
        android:height="24dp"
        android:viewportWidth="24"
        android:viewportHeight="24"
        android:tint="?attr/colorControlNormal">
    <!-- Body of the lock. -->
    <path
            android:fillColor="@android:color/white"
            android:pathData="M6,10h8c1.1,0 2,0.9 2,2v7c0,1.1 -0.9,2 -2,2H6c-1.1,0 -2,-0.9 -2,-2v-7C4,10.9 4.9,10 6,10zM10,14c-0.83,0 -1.5,0.67 -1.5,1.5c0,0.83 0.67,1.5 1.5,1.5s1.5,-0.67 1.5,-1.5C11.5,14.67 10.83,14 10,14z"/>
    <!-- Shackle, drawn open to the right: this is the unlock action, not a locked state. -->
    <path
            android:fillColor="@android:color/white"
            android:pathData="M14,10V7c0,-1.66 1.34,-3 3,-3s3,1.34 3,3h-2c0,-0.55 -0.45,-1 -1,-1s-1,0.45 -1,1v3H14z"/>
</vector>
