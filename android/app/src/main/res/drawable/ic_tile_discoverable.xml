<!--
  Quick Settings tile icon, discoverable state: padlock plus signal bars.

  Carries no colour of its own and no background. Quick Settings tints the glyph and supplies the
  on/off background itself, so an icon that paints its own state ends up contradicting the tile it
  sits in. State is expressed by shape only — see ic_tile_discoverable_off for the counterpart.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="24dp"
        android:height="24dp"
        android:viewportWidth="24"
        android:viewportHeight="24"
        android:tint="?attr/colorControlNormal">
    <!-- Body and keyhole in one path so evenOdd punches the keyhole out rather than filling it. -->
    <path
            android:fillColor="@android:color/white"
            android:fillType="evenOdd"
            android:pathData="M4,10h6c1.1,0 2,0.9 2,2v6c0,1.1 -0.9,2 -2,2H4c-1.1,0 -2,-0.9 -2,-2v-6C2,10.9 2.9,10 4,10zM7,13.5a1.4,1.4 0 1 0 0,2.8 1.4,1.4 0 1 0 0,-2.8z"/>
    <!-- Shackle. -->
    <path
            android:fillColor="@android:color/white"
            android:pathData="M4.2,10V8.2c0,-1.55 1.25,-2.8 2.8,-2.8s2.8,1.25 2.8,2.8V10H8V8.2c0,-0.55 -0.45,-1 -1,-1s-1,0.45 -1,1V10H4.2z"/>
    <!-- Rising bars: the phone is broadcasting. Grows away from the lock so the pair reads as
         "lock, reaching out" rather than as a signal-strength meter. -->
    <path
            android:fillColor="@android:color/white"
            android:pathData="M14,16h1.6v4H14zM17,13.5h1.6v6.5H17zM20,11h1.6v9H20z"/>
</vector>
