<!--
  Quick Settings tile icon, not-discoverable state: the padlock on its own.

  Identical lock geometry to ic_tile_discoverable; the only difference is the missing signal bars.
  Nothing is broadcasting, so nothing reaches out of the lock.

  The lock does still appear to shift slightly between the two states, because One UI centres the
  glyph on its ink rather than on the 24dp viewport, and dropping the bars changes where that centre
  falls. Harmless, and not worth padding the viewport to hide.

  Used for every non-broadcasting case — paused, switched off, Bluetooth off, permission missing.
  Those are distinguished in the tile subtitle rather than by four near-identical glyphs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="24dp"
        android:height="24dp"
        android:viewportWidth="24"
        android:viewportHeight="24"
        android:tint="?attr/colorControlNormal">
    <path
            android:fillColor="@android:color/white"
            android:fillType="evenOdd"
            android:pathData="M4,10h6c1.1,0 2,0.9 2,2v6c0,1.1 -0.9,2 -2,2H4c-1.1,0 -2,-0.9 -2,-2v-6C2,10.9 2.9,10 4,10zM7,13.5a1.4,1.4 0 1 0 0,2.8 1.4,1.4 0 1 0 0,-2.8z"/>
    <path
            android:fillColor="@android:color/white"
            android:pathData="M4.2,10V8.2c0,-1.55 1.25,-2.8 2.8,-2.8s2.8,1.25 2.8,2.8V10H8V8.2c0,-0.55 -0.45,-1 -1,-1s-1,0.45 -1,1V10H4.2z"/>
    <!-- No bars, and deliberately nothing in their place.
         Two alternatives were tried on device and both read worse. A cross looked like "delete" and
         floated away from the lock. A slash needs something to strike through, and it cannot cross the
         lock itself: Quick Settings tints the whole glyph one flat colour, so a slash over the filled
         body simply vanishes into it — the notch that makes the platform's own struck-through icons
         work is a cut-out, which a single-colour fill cannot express here.
         Absence of the bars is the clearest available signal, and Quick Settings is already colouring
         the tile by state on top of it. -->

</vector>
